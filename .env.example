# Prisma AIRS — Management API (OAuth 2.0)
PANW_CLIENT_ID=your-client-id
PANW_CLIENT_SECRET=your-client-secret

# Prisma AIRS — Scan API
PANW_AI_SEC_API_KEY=your-scan-api-key
PRISMA_AIRS_PROFILE=redteamtest

# OpenAI (for the wrapper VM)
OPENAI_API_KEY=your-openai-key
LLM_MODEL=gpt-4o-mini

# GCP (for VM deployment)
GCP_PROJECT=your-gcp-project
